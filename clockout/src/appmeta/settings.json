    "mon": { "label": "Monday", "type": "boolean", "default": true },
    "tue": { "label": "Tuesday", "type": "boolean", "default": true },
    "wed": { "label": "Wednesday", "type": "boolean", "default": true },
    "thu": { "label": "Thursday", "type": "boolean", "default": true },
    "fri": { "label": "Friday", "type": "boolean", "default": true },
    "sat": { "label": "Saturday", "type": "boolean", "default": false },
    "sun": { "label": "Sunday", "type": "boolean", "default": false },
    "clock": {
